{
	"name": "poe-overlay",
	"version": "0.1.0",
	"description": "Path of Exile levelling companion",
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"build": "vite build",
		"serve": "vite preview",
		"tauri": "tauri",
		"check": "biome check . && tsc --noEmit",
		"fix": "biome check --write .",
		"test": "vitest run --passWithNoTests",
		"gate": "node scripts/gate.mjs",
		"preview:shots": "node scripts/preview.mjs",
		"build:signed": "node scripts/build-signed.mjs",
		"icon": "node scripts/icon.mjs",
		"prepare": "git config core.hooksPath .githooks",
		"layouts": "python scripts/layouts/install.py"
	},
	"license": "MIT",
	"dependencies": {
		"@fontsource/barlow-semi-condensed": "^5.3.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"solid-js": "^1.9.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@tauri-apps/cli": "^2",
		"jsdom": "^26.1.0",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-solid": "^2.11.12",
		"vitest": "^5.1.1"
	},
	"packageManager": "pnpm@9.15.9"
}
