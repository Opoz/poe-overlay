{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "poe-overlay",
	"version": "0.1.0",
	"identifier": "com.opoz.poe-overlay",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "poe-overlay",
				"width": 960,
				"height": 680,
				"minWidth": 640,
				"minHeight": 480
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
