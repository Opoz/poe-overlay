{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Main window and Overlays",
	"windows": [
		"main",
		"timer",
		"tree",
		"guide",
		"act",
		"gems",
		"lab",
		"treebar",
		"xp"
	],
	"permissions": [
		"core:default",
		"core:window:allow-start-dragging",
		"core:window:allow-set-size",
		"core:window:allow-set-position",
		"updater:default",
		"process:allow-restart"
	]
}
